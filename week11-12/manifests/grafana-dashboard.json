{
  "title": "Kubernetes App Dashboard",
  "panels": [
    {
      "title": "Pod CPU Usage (%)",
      "type": "graph",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [{
        "expr": "rate(container_cpu_usage_seconds_total{container=\"app\"}[5m]) * 100",
        "legendFormat": "CPU"
      }]
    },
    {
      "title": "Pod Memory Usage (MB)",
      "type": "graph",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [{
        "expr": "container_memory_working_set_bytes{container=\"app\"} / 1024 / 1024",
        "legendFormat": "Memory"
      }]
    }
  ]
}